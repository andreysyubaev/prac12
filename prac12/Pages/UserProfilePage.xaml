<Page x:Class="prac12.Pages.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prac12.Pages"
      xmlns:validators="clr-namespace:prac12.Validators"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserProfilePage">
    <Page.Resources>
        <validators:UserProfileValid x:Key="userProfileValid"/>
        <validators:PhoneNumberValid x:Key="phoneNumberValid"/>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Margin="80,0" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0"
                           Width="120" Height="120"
                           x:Name="AvatarImage"
                           Source="{Binding UserProfile.AvatarUrl}"
                           Stretch="UniformToFill"/>
                    <Button Grid.Row="1" 
                            Content="Выбрать фото" Click="SelectAvatar_Click"/>
                </Grid>

                <Grid Grid.Column="1">
                    <StackPanel>
                        <StackPanel>
                            <Label>Номер телефона</Label>
                            <TextBox x:Name="Phone" Validation.ErrorTemplate="{x:Null}">
                                <TextBox.Text>
                                    <Binding Path="UserProfile.Phone"
                                             UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <validators:PhoneNumberValid/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <ItemsControl ItemsSource="{Binding ElementName=Phone,
                                Path=(Validation.Errors)}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Label Content="{Binding ErrorContent}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel>
                            <Label>Дата рождения</Label>
                            <DatePicker x:Name="Birthday" SelectedDate="{Binding UserProfile.Birthday}"></DatePicker>
                        </StackPanel>
                        <StackPanel>
                            <Label>Описание</Label>
                            <TextBox x:Name="Bio" Validation.ErrorTemplate="{x:Null}">
                                <TextBox.Text>
                                    <Binding Path="UserProfile.Bio"
                                             UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <validators:UserProfileValid/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <ItemsControl ItemsSource="{Binding ElementName=Bio,
                                Path=(Validation.Errors)}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Label Content="{Binding ErrorContent}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel>
                            <Label></Label>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="Back_Click" Content="Назад"/>
            <Button Grid.Column="1" Click="Save_Click" Content="Сохранить"/>
        </Grid>
    </Grid>
</Page>
