<Page x:Class="prac12.Pages.RegInterestGroup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prac12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegInterestGroup">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <Label Content="Информация о пользователе" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       HorizontalContentAlignment="Center"/>
                <Label Content="{Binding user.Name}"/>
                <Label Content="{Binding user.Email}"/>
                <StackPanel>
                    <Label Content="Дата вступления в группу"/>
                    <DatePicker x:Name="Date" SelectedDate="{Binding userInterestGroup.JoinedAt, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel>
                    <Label Content="Роль в группе"/>
                    <CheckBox Content="Модератор"
                              IsChecked="{Binding userInterestGroup.IsModerator}"/>
                </StackPanel>
            </StackPanel>
            
            <Border Grid.Column="1">
                <ListView x:Name="GroupListView"
                          ItemsSource="{Binding interestGroupService.InterestGroups}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Title}" FontWeight="SemiBold"/>
                                <Run Text=" | " FontWeight="Light"/>
                                <Run Text="{Binding Description}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="Back_Click" Content="Назад"/>
            <Button Grid.Column="1" Click="Join_Click" Content="Вступить в группу"/>
        </Grid>
    </Grid>
</Page>
